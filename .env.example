# Copy to .env to override. Read by the Makefile and docker-compose.yml; the app itself needs no configuration.

# Port of the development server (make dev, docker compose up)
DEV_PORT=5173
# Build target for `make build`: single (one HTML file), web (static site) or all
TARGET=all
# Source spreadsheets for `make data` (see data/source/README.md)
NEXUS_XLSX=data/source/DOS2_DE_Eng.xlsx
INFO_XLSX=data/source/DOS2_Info_Shared.xlsx
