{
  "name": "rivellon-codex",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Divinity: Original Sin 2 DE companion: skills, statuses, recipes, party and item tracker.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:single && npm run build:web",
    "build:single": "vite build --mode single",
    "build:web": "vite build --mode web",
    "preview": "vite preview --mode web",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "data:nexus": "tsx tools/extract-nexus.ts",
    "data:info": "tsx tools/extract-info.ts",
    "data:icons": "tsx tools/build-icons.ts"
  },
  "dependencies": {
    "immer": "^11.1.21",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@iconify-json/game-icons": "^1.2.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
